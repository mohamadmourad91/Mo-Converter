<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">

  <!-- Name, Publisher and PublisherDisplayName must be the values Partner Center shows under
       "Product identity" once the app name is reserved. build/msix.ps1 fills the placeholders. -->
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Mo Converter</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="de-de" />
    <Resource Language="ar-sa" />
  </Resources>

  <Applications>
    <Application Id="MoConverter" Executable="Mo Converter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Mo Converter"
                          Description="Convert, compress and edit files by dragging them onto a wheel."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\SmallTile.png"
                         Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" in the settings switches this task (see StartupRegistration.cs). -->
        <desktop:Extension Category="windows.startupTask" Executable="Mo Converter.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MoConverterStartup" Enabled="false" DisplayName="Mo Converter" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop program that watches the mouse and keyboard state system-wide and starts other programs. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>