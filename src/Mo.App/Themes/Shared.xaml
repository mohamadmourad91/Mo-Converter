<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="Mo.TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mo.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A settings group: rounded card with a soft border. -->
    <Style x:Key="Mo.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Mo.Card.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Mo.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Mo.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mo.TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,4,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource Mo.Text}" />
    </Style>

    <Style x:Key="Mo.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mo.TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Mo.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Mo.Hint" TargetType="TextBlock" BasedOn="{StaticResource Mo.Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Mo.SubtleText}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="Mo.Divider" TargetType="Separator">
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Background" Value="{DynamicResource Mo.Card.Border}" />
    </Style>
</ResourceDictionary>
