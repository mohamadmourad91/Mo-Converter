<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The same indigo, lifted so it reads on dark surfaces. -->
    <Color x:Key="Mo.AccentColor">#FF8E8AFF</Color>
    <SolidColorBrush x:Key="Mo.Accent" Color="{StaticResource Mo.AccentColor}" />
    <SolidColorBrush x:Key="Mo.AccentText" Color="#FF12131B" />
    <SolidColorBrush x:Key="Mo.Text" Color="#FFECEDF3" />
    <SolidColorBrush x:Key="Mo.SubtleText" Color="#FFA3A6B6" />

    <SolidColorBrush x:Key="Mo.Wheel.Plate" Color="#F01A1B22" />
    <SolidColorBrush x:Key="Mo.Wheel.PlateBorder" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Mo.Wheel.Petal" Color="#FF2A2C36" />
    <SolidColorBrush x:Key="Mo.Wheel.Text" Color="#FFECEDF3" />
    <SolidColorBrush x:Key="Mo.Wheel.SubtleText" Color="#FF9C9FB0" />
    <SolidColorBrush x:Key="Mo.Wheel.Hub" Color="#FF21222B" />

    <SolidColorBrush x:Key="Mo.Toast.Background" Color="#F5202129" />
    <SolidColorBrush x:Key="Mo.Toast.Border" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Mo.Toast.Track" Color="#338E8AFF" />

    <SolidColorBrush x:Key="Mo.Card.Background" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Mo.Card.Border" Color="#1AFFFFFF" />
</ResourceDictionary>
