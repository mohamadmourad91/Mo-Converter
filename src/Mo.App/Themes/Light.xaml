<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One accent colour across the app: a deep indigo. -->
    <Color x:Key="Mo.AccentColor">#FF4B46D8</Color>
    <SolidColorBrush x:Key="Mo.Accent" Color="{StaticResource Mo.AccentColor}" />
    <SolidColorBrush x:Key="Mo.AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Mo.Text" Color="#FF1B1D26" />
    <SolidColorBrush x:Key="Mo.SubtleText" Color="#FF5D6070" />

    <SolidColorBrush x:Key="Mo.Wheel.Plate" Color="#EEE9EBF2" />
    <SolidColorBrush x:Key="Mo.Wheel.PlateBorder" Color="#24000000" />
    <SolidColorBrush x:Key="Mo.Wheel.Petal" Color="#FFFDFDFF" />
    <SolidColorBrush x:Key="Mo.Wheel.Text" Color="#FF1B1D26" />
    <SolidColorBrush x:Key="Mo.Wheel.SubtleText" Color="#FF6A6D7C" />
    <SolidColorBrush x:Key="Mo.Wheel.Hub" Color="#FFF6F7FB" />

    <SolidColorBrush x:Key="Mo.Toast.Background" Color="#F7FBFBFE" />
    <SolidColorBrush x:Key="Mo.Toast.Border" Color="#1F000000" />
    <SolidColorBrush x:Key="Mo.Toast.Track" Color="#1A4B46D8" />

    <SolidColorBrush x:Key="Mo.Card.Background" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Mo.Card.Border" Color="#14000000" />
</ResourceDictionary>
