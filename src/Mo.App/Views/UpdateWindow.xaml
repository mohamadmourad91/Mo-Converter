<Window x:Class="Mo.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Mo.App.Views"
        Title="{v:T update.title}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Mo.TextFont}">
    <StackPanel Margin="24,22,24,20">
        <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Mo.Accent}">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Mo.IconFont}" FontSize="18"
                           Foreground="{DynamicResource Mo.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{v:T update.title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Mo.Text}" />
                <TextBlock Text="{v:T app.name}" FontSize="12" Foreground="{DynamicResource Mo.SubtleText}" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageText" Margin="0,18,0,0" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Mo.Text}" />
        <TextBlock Style="{StaticResource Mo.Hint}" Margin="0,8,0,0" Text="{v:T update.paused}" />

        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountdownText" VerticalAlignment="Center" Foreground="{DynamicResource Mo.SubtleText}" />
            <Button x:Name="UpdateButton" Grid.Column="1" MinWidth="130" Padding="16,6" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Content="{v:T update.now}" Click="OnUpdateClick" />
        </Grid>
    </StackPanel>
</Window>
