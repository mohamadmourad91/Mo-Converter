<Window x:Class="Mo.App.Views.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Mo.App.Views"
        Title="{v:T qr.title}"
        Width="540" Height="700" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Mo.TextFont}">
    <Window.Resources>
        <v:BytesToImageConverter x:Key="BytesToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Mo.Accent}">
                <TextBlock Text="&#xED14;" FontFamily="{StaticResource Mo.IconFont}" FontSize="18"
                           Foreground="{DynamicResource Mo.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{v:T qr.title}" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Mo.Text}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource Mo.Label}" Text="{v:T qr.prompt}" Margin="0,0,0,6" />
            <TextBox x:Name="Input" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="{Binding Error}" Foreground="#D13438" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,12" CornerRadius="10" Background="White" Padding="16">
            <Image Source="{Binding Png, Converter={StaticResource BytesToImage}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="14,6" Content="{v:T qr.copy}" Click="OnCopy" IsEnabled="{Binding HasCode}" />
            <Button Padding="14,6" Margin="8,0,0,0" Content="{v:T qr.save-svg}" Click="OnSaveSvg" IsEnabled="{Binding HasCode}" />
            <Button Padding="14,6" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Content="{v:T qr.save-png}" Click="OnSavePng" IsEnabled="{Binding HasCode}" />
        </StackPanel>
    </Grid>
</Window>
