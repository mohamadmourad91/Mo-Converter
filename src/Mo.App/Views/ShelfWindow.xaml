<Window x:Class="Mo.App.Views.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Mo.App.Views"
        Title="{v:T shelf.title}"
        Width="300" Height="460" MinWidth="240" MinHeight="260"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Left="40" Top="120"
        AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" Drop="OnDrop"
        FontFamily="{StaticResource Mo.TextFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <v:InvertBoolConverter x:Key="InvertBool" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Padding="8,2" Content="{v:T shelf.clear}" Command="{Binding ClearCommand}" />
            <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Foreground="{DynamicResource Mo.SubtleText}" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,10" CornerRadius="10" Background="{DynamicResource Mo.Wheel.Plate}">
            <Grid>
                <ListBox x:Name="List" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Padding="6"
                         PreviewMouseLeftButtonDown="OnPress" PreviewMouseMove="OnDrag" Visibility="{Binding IsEmpty, Converter={StaticResource InvertBool}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Mo.Text}" />
                                <Button Grid.Column="1" Padding="6,0" Margin="6,0,0,0" Content="&#xE711;"
                                        FontFamily="{StaticResource Mo.IconFont}" ToolTip="{v:T shelf.remove}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="Empty" Text="{v:T shelf.empty}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource Mo.SubtleText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Style="{StaticResource Mo.Hint}" Text="{v:T shelf.hint}" TextWrapping="Wrap" />
    </Grid>
</Window>
