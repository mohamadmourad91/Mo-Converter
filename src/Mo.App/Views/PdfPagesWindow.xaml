<Window x:Class="Mo.App.Views.PdfPagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Mo.App.Views"
        Width="1000" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Mo.TextFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" x:Name="CountText" Text="{Binding CountText}" Foreground="{DynamicResource Mo.SubtleText}" VerticalAlignment="Center" />
            <TextBlock x:Name="HintText" Style="{StaticResource Mo.Hint}" Text="{v:T pages.hint}" />
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource Mo.Wheel.Plate}">
            <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" Background="Transparent" BorderThickness="0" Padding="8"
                     AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="OnPressTile" PreviewMouseMove="OnDragTile" Drop="OnDropTile">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="168" Margin="6" Padding="8" CornerRadius="8" Background="{DynamicResource Mo.Wheel.Petal}">
                            <StackPanel>
                                <Grid Height="176">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="172" MaxWidth="150">
                                        <Image.LayoutTransform>
                                            <RotateTransform Angle="{Binding Rotation}" />
                                        </Image.LayoutTransform>
                                    </Image>
                                </Grid>
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6,0,6" Foreground="{DynamicResource Mo.Text}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Padding="6,4" Margin="2,0" MinWidth="0" FontFamily="{StaticResource Mo.IconFont}" FontSize="13" CommandParameter="{Binding}" Content="{DynamicResource Mo.EarlierGlyph}" ToolTip="{v:T pages.left}"
                                            Command="{Binding DataContext.EarlierCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Button Padding="6,4" Margin="2,0" MinWidth="0" FontFamily="{StaticResource Mo.IconFont}" FontSize="13" CommandParameter="{Binding}" Content="&#xE7AD;" ToolTip="{v:T pages.rotate}"
                                            Command="{Binding DataContext.RotateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Button Padding="6,4" Margin="2,0" MinWidth="0" FontFamily="{StaticResource Mo.IconFont}" FontSize="13" CommandParameter="{Binding}" Content="&#xE8C8;" ToolTip="{v:T pages.duplicate}"
                                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Button Padding="6,4" Margin="2,0" MinWidth="0" FontFamily="{StaticResource Mo.IconFont}" FontSize="13" CommandParameter="{Binding}" Content="&#xE74D;" ToolTip="{v:T pages.remove}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Button Padding="6,4" Margin="2,0" MinWidth="0" FontFamily="{StaticResource Mo.IconFont}" FontSize="13" CommandParameter="{Binding}" Content="{DynamicResource Mo.LaterGlyph}" ToolTip="{v:T pages.right}"
                                            Command="{Binding DataContext.LaterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button MinWidth="160" Padding="16,6" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"
                    Content="{v:T pages.save}" Click="OnSave" x:Name="SaveButton" IsEnabled="False" />
            <Button MinWidth="110" Padding="16,6" Margin="8,0,0,0" IsCancel="True" Content="{v:T editor.cancel}" />
        </StackPanel>
    </Grid>
</Window>
