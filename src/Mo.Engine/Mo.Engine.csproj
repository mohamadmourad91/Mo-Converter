<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Mo.Engine</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Locales\*.json" WithCulture="false" />
    <InternalsVisibleTo Include="Mo.Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Word, Excel and PowerPoint files (MIT). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Images (Apache-2.0). -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
    <!-- Markdown reading (BSD-2-Clause). -->
    <PackageReference Include="Markdig" Version="1.6.0" />
    <!-- PDF text extraction (Apache-2.0). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- PDF merge, split, rotate, compress. Stay on 6.2.x: it is MIT. 6.5.0 switched to AGPL-3.0 with a license check. -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <!-- Making QR codes (MIT); only the PNG and SVG writers are used, not System.Drawing. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- Reading ZIP, 7z, RAR, TAR and GZ archives (MIT). -->
    <PackageReference Include="SharpCompress" Version="0.50.9" />
    <!-- PDFsharp brings 8.0.1, which has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Reading QR codes and barcodes (Apache-2.0). -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>

